# Copy to config.env and fill in. Nothing here is a secret except what you add.
NETWORK=mainnet                      # testnet | mainnet
AVM_ADDRESS=                         # Algorand address that receives USDC (payTo)
FACILITATOR_URL=https://facilitator.goplausible.xyz
CHALLENGE_TAG=x402-global-challenge
PUBLIC_BASE=https://your-domain.example
PRICE_USD=$0.01
ASK_PRICE=$0.05
VISIT_PRICE=$0.02
DISPATCH_PRICE=$0.01
SCOUT_PRICE=$0.05
SCOUT_MIN_INDEPENDENT=1               # scout is not charged unless this many paid second opinions came back
WASHREPORT_PRICE=$0.02
WASHCHECK_PRICE=$0.005
WASHCLUSTERS_PRICE=$0.05
WASHAUDIT_PRICE=$5.00
WATCH_PRICE=$0.02
WATCH_FREE_EPISODES=3
WATCH_SECRET=                         # set a long random value if you sell episodes; signs viewing links
RATE_PER_MIN=60
DATA_DIR=/opt/x402/data
ASK_BRIDGE_URL=http://127.0.0.1:8093  # local LLM bridge that answers /commission/ask, /visit, /scout
WORLD_STATE_URL=http://127.0.0.1:8089 # world-state cache
AGENT_ADDRESSES=                      # comma-separated agent wallet addresses
NTFY_TOPIC=                           # optional: ntfy.sh topic for sale notifications (empty = off)
